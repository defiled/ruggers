# API server (server/index.mjs)
PORT=8787
FEEDBACK_DB=data/feedback.db
# Needed to read feedback over HTTP (GET /api/feedback?key=...). The CLI (npm run feedback) needs no key.
ADMIN_KEY=
# Optional: Slack / Discord / Google Chat incoming webhook that gets a message for every submission.
FEEDBACK_WEBHOOK_URL=

# Web app (Vite, baked in at build time)
# Optional fallback shown when the API is unreachable, e.g. on static hosting.
VITE_FEEDBACK_EMAIL=
# Session replay (LogRocket, app id in src/analytics.ts). On in production builds only; set to 1 to turn it on in `npm run dev`.
VITE_LOGROCKET=
