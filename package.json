{
  "name": "steamrollers-rugby",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c green,blue \"vite\" \"node --no-warnings server/index.mjs\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "web": "vite",
    "api": "node --no-warnings server/index.mjs",
    "start": "npm run build && node --no-warnings server/index.mjs",
    "feedback": "node --no-warnings scripts/feedback-list.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "logrocket": "^12.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
